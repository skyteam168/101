# 复制为 .env，或运行: pnpm --filter @restaurant/mcp-analytics mint-token
# 线上建议: RESTAURANT_API_BASE=http://127.0.0.1:3000/api（同机回环）或公网 /api

RESTAURANT_API_BASE=http://127.0.0.1:3000/api
RESTAURANT_TOKEN=

# 给 AI 平台「在线服务 HTTP」填的密钥
MCP_API_KEY=
MCP_HTTP_PORT=3100
MCP_HTTP_HOST=0.0.0.0
MCP_ALLOWED_HOSTS=www.nhahang101.top,localhost,127.0.0.1
