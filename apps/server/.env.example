NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://restaurant:restaurant@127.0.0.1:3307/restaurant"
REDIS_URL="redis://127.0.0.1:6379"
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES="2h"
JWT_REFRESH_EXPIRES="7d"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# 经 Cloudflare / Nginx 反代时保持开启，用于解析真实客户端 IP
TRUST_PROXY="1"
# Cloudflare Turnstile（H5 + Admin 登录防机器人）。请填 Cloudflare 控制台真实 Site Key / Secret；
# 站点域名需同时允许 Admin / H5 来源。占位符或留空时前端不显示验证框，后端跳过校验。
# CF_TURNSTILE_SITE_KEY="0x4AAAAA...."
# CF_TURNSTILE_SECRET_KEY="0x4AAAAA...."
# 登录失败锁定（Redis）：账号 5 次 / IP 20 次 → 锁定 15 分钟
# LOGIN_MAX_FAILS=5
# LOGIN_MAX_IP_FAILS=20
# LOGIN_FAIL_WINDOW_SECONDS=900
# LOGIN_LOCK_SECONDS=900
# Google Identity Services。填 Google Cloud「Web 应用」OAuth 客户端 ID；
# 并在客户端里把 H5 域名加入「已获授权的 JavaScript 来源」。未配置则隐藏 Google 按钮。
# GOOGLE_CLIENT_ID="123456789-xxxx.apps.googleusercontent.com"
# 手机扫桌贴二维码用局域网地址，例如 http://192.168.1.8:5174（勿用 localhost）
# H5_BASE_URL="http://192.168.1.8:5174"
UPLOAD_DIR="uploads"
STORAGE_DRIVER="local"
