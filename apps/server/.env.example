NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://restaurant:restaurant@127.0.0.1:3307/restaurant"
REDIS_URL="redis://127.0.0.1:6379"

# —— JWT（生产：≥32 位随机串；禁止 change-me / dev-secret）——
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES="2h"
JWT_REFRESH_EXPIRES="7d"

# 开发可用 *；生产必须写成明确域名列表，逗号分隔
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# 经 Cloudflare / Nginx 反代时保持开启，用于解析真实客户端 IP
TRUST_PROXY="1"

# 生产默认关闭 Swagger；本地默认开启。强制开启：ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false

# —— Cloudflare Turnstile（H5 + Admin 登录防机器人）——
# 生产强制要求。占位符或留空时前端不显示验证框，后端跳过校验（仅本地）。
# 1) Cloudflare Dashboard → Turnstile → Add widget
# 2) Domains 填生产域名（如 h5.example.com、admin.example.com），勿只填 localhost
# 3) Widget Mode 选 Managed；把 Site Key / Secret Key 写入下方
# 4) 前端通过 VITE_CF_TURNSTILE_SITE_KEY（或服务端注入）加载；校验走 siteverify
# CF_TURNSTILE_SITE_KEY="0x4AAAAA...."
# CF_TURNSTILE_SECRET_KEY="0x4AAAAA...."

# 登录失败锁定（Redis）
# LOGIN_MAX_FAILS=5
# LOGIN_MAX_IP_FAILS=20
# LOGIN_FAIL_WINDOW_SECONDS=900
# LOGIN_LOCK_SECONDS=900

# —— Google Identity Services（H5「用 Google 登录」）——
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# 2) Authorized JavaScript origins 必须含 H5 真实 Origin，例如：
#    https://h5.example.com
#    http://localhost:5174   （仅本地联调）
#    不要填路径，不要漏协议/端口；与浏览器地址栏 Origin 完全一致
# 3) Authorized redirect URIs：GIS 按钮流一般可不填；若用 redirect 模式再补
# 4) 将 Client ID 写入下方；前端 VITE_GOOGLE_CLIENT_ID 需与此一致
# GOOGLE_CLIENT_ID="123456789-xxxx.apps.googleusercontent.com"

# —— 云打印 Webhook（可选）——
# 打印机 connectionType=cloud 时，服务端 POST PrintJobMessage 到打印机 ip 字段的 URL
# CLOUD_PRINT_WEBHOOK_SECRET="shared-hmac-or-bearer"
# CLOUD_PRINT_WEBHOOK_TIMEOUT_MS=8000

# 手机扫桌贴二维码用局域网/公网 H5 地址（勿用 localhost 给顾客扫）
# H5_BASE_URL="https://h5.example.com"

# 公开外卖/首页/聊天等未传 storeId 时的默认门店（多店部署务必改成真实 id）
# DEFAULT_STORE_ID="1"

# —— 邮件 SMTP（验证码；生产强制；也可在后台「门店设置」配置）——
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="好运中餐厅 <noreply@example.com>"

# —— 打印代理 seed 密钥（pnpm db:seed 时写入 agent id=1；生产必填 ≥16 位）——
# PRINT_AGENT_SEED_SECRET="replace-with-long-random-secret"

UPLOAD_DIR="uploads"
# local | oss（生产必须 oss，并配齐下方 OSS_*；本地开发可用 local）
STORAGE_DRIVER="local"

# —— 阿里云 OSS（STORAGE_DRIVER=oss）——
# OSS_REGION="oss-ap-southeast-1"
# OSS_ACCESS_KEY="LTAI..."
# OSS_SECRET_KEY="..."
# OSS_BUCKET="your-bucket"
# 对外访问根（无尾斜杠）；不填则用 https://{bucket}.{region}.aliyuncs.com
# STORAGE_PUBLIC_BASE_URL="https://cdn.example.com"
# CDN_BASE_URL="https://cdn.example.com"
